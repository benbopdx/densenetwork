# ─────────────────────────────────────────────
# DenseNet – required configuration
# ─────────────────────────────────────────────

# Airtable credentials
# Get your personal access token at: https://airtable.com/account
AIRTABLE_API_KEY=your_airtable_personal_access_token

# Your Airtable base ID (found in the URL: airtable.com/appXXXXXX/...)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# The table name containing your contacts
AIRTABLE_TABLE_NAME=Contacts

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# Optional: web search enrichment
# ─────────────────────────────────────────────

# Brave Search API key for enriching contact profiles with public data
# Get one at: https://api.search.brave.com/
BRAVE_API_KEY=

# ─────────────────────────────────────────────
# Optional: field name overrides
# ─────────────────────────────────────────────
# If your Airtable uses different column names, set them here.
# Defaults shown – only change what differs from your table.

# FIELD_NAME=Name
# FIELD_EMAIL=Email
# FIELD_COMPANY=Company
# FIELD_TITLE=Title
# FIELD_PHONE=Phone
# FIELD_LOCATION=Location
# FIELD_LINKEDIN=LinkedIn URL
# FIELD_TWITTER=Twitter
# FIELD_WEBSITE=Website
# FIELD_NOTES=Notes
# FIELD_TAGS=Tags

# ─────────────────────────────────────────────
# Optional: storage
# ─────────────────────────────────────────────

# Path to the local SQLite database (default: densenet.db in current directory)
# DATABASE_PATH=densenet.db

# ─────────────────────────────────────────────
# Granola digest (densenet digest)
# ─────────────────────────────────────────────

# Who receives the morning digest
EMAIL_TO=ben@praxis.co

# Sender address shown in the From: header
EMAIL_FROM=ben@praxis.co

# SMTP credentials (Gmail example — use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ben@praxis.co
SMTP_PASSWORD=your-app-password-here

# Path to Granola's local SQLite DB (macOS default shown — usually works as-is)
# GRANOLA_DB_PATH=~/Library/Application Support/Granola/granola.db

# Alternative: directory of exported Granola notes (.md / .txt files)
# GRANOLA_NOTES_DIR=~/Documents/granola-notes
